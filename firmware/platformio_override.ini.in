; The build environments of the firmware. `python3 firmware/fw.py build` writes this file
; into WLED's folder as platformio_override.ini, with the repository's path filled in.
; Everything not named here is inherited from WLED's own environment esp32s3dev_16MB_opi:
; the board, the platform, the partition table and the flash settings. odrig and
; odrig_probe are the USB stick's firmware on WLED's own platform. odrig_microsd, the
; firmware, and odrig_microsd_probe take the platform of the newer software, which that
; software's own PlatformIO builds, in build/firmware/newer/, and read a microSD card on
; GPIO39 to GPIO42 in place of the USB stick. odrig_microsd_n8r2 is the firmware built for
; the spare board's module, with 8 MB of flash and 2 MB of quad PSRAM: the memory type
; qio_qspi, the flash size 8MB, the tracked table firmware/partitions/odrig-8mb.csv and
; the release name odrig_ESP32-S3_8MB_qspi, in place of what odrig_microsd gives it.

[env:odrig]
extends = env:esp32s3dev_16MB_opi
custom_usermods =
  odrig = symlink://@REPO@/firmware/usermod
lib_deps = ${esp32s3.lib_deps}
  odrig_core = symlink://@REPO@/core
  usb_host_msc = symlink://@REPO@/firmware/usb_host_msc
build_unflags = ${common.build_unflags}
build_flags = ${common.build_flags} ${esp32s3.build_flags}
  -D WLED_RELEASE_NAME=\"odrig_ESP32-S3_16MB_opi\"
  -D WLED_WATCHDOG_TIMEOUT=0
  -D ARDUINO_USB_CDC_ON_BOOT=1
  -DBOARD_HAS_PSRAM
  -D WLED_DISABLE_ADALIGHT
  -I"@REPO@/core/include"
  -I"@REPO@/firmware/usermod/wled"
  -I"@REPO@/firmware/usb_host_msc/include"

[env:odrig_probe]
extends = env:odrig
build_flags = ${env:odrig.build_flags}
  -D ODRIG_PROBE

[env:odrig_microsd]
extends = env:odrig
platform = https://github.com/pioarduino/platform-espressif32/releases/download/55.03.312-1/platform-espressif32.zip
platform_packages =
lib_ignore = esp_dmx
  IRremoteESP8266
  NeoESP32RmtHI
build_unflags = ${env:odrig.build_unflags}
  -D WLED_ENABLE_DMX_INPUT
build_flags = ${env:odrig.build_flags}
  -D WLED_DISABLE_INFRARED
  -D WLED_USE_SHARED_RMT
  -D ESP32_ARDUINO_NO_RGB_BUILTIN
  -include "@REPO@/firmware/newer/odrig_newer.h"
  -D ODRIG_DRIVE_SD_SPI
  -D ODRIG_SD_SCK=39
  -D ODRIG_SD_MISO=40
  -D ODRIG_SD_MOSI=41
  -D ODRIG_SD_CS=42

[env:odrig_microsd_probe]
extends = env:odrig_microsd
build_flags = ${env:odrig_microsd.build_flags}
  -D ODRIG_PROBE

[env:odrig_microsd_n8r2]
extends = env:odrig_microsd
board_build.arduino.memory_type = qio_qspi
board_build.partitions = @REPO@/firmware/partitions/odrig-8mb.csv
board_upload.flash_size = 8MB
board_upload.maximum_size = 3145728
build_unflags = ${env:odrig_microsd.build_unflags}
  -D WLED_RELEASE_NAME=\"odrig_ESP32-S3_16MB_opi\"
build_flags = ${env:odrig_microsd.build_flags}
  -D WLED_RELEASE_NAME=\"odrig_ESP32-S3_8MB_qspi\"
