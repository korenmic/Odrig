; The build environments of the firmware. `python3 firmware/fw.py build` writes this file
; into WLED's folder as platformio_override.ini, with the repository's path filled in.
; Everything not named here is inherited from WLED's own environment esp32s3dev_16MB_opi:
; the board, the platform, the partition table and the flash settings. The trial's two
; environments take the platform of the newer USB software, which the newer software's
; own PlatformIO builds, in build/firmware/newer/.

[env:odrig]
extends = env:esp32s3dev_16MB_opi
custom_usermods =
  odrig = symlink://@REPO@/firmware/usermod
lib_deps = ${esp32s3.lib_deps}
  odrig_core = symlink://@REPO@/core
  usb_host_msc = symlink://@REPO@/firmware/usb_host_msc
build_unflags = ${common.build_unflags}
build_flags = ${common.build_flags} ${esp32s3.build_flags}
  -D WLED_RELEASE_NAME=\"odrig_ESP32-S3_16MB_opi\"
  -D WLED_WATCHDOG_TIMEOUT=0
  -D ARDUINO_USB_CDC_ON_BOOT=1
  -DBOARD_HAS_PSRAM
  -D WLED_DISABLE_ADALIGHT
  -I@REPO@/core/include
  -I@REPO@/firmware/usermod/wled
  -I@REPO@/firmware/usb_host_msc/include

[env:odrig_probe]
extends = env:odrig
build_flags = ${env:odrig.build_flags}
  -D ODRIG_PROBE

[env:odrig_trial]
extends = env:odrig
platform = https://github.com/pioarduino/platform-espressif32/releases/download/55.03.312-1/platform-espressif32.zip
platform_packages =
lib_ignore = esp_dmx
  IRremoteESP8266
  NeoESP32RmtHI
build_unflags = ${env:odrig.build_unflags}
  -D WLED_ENABLE_DMX_INPUT
build_flags = ${env:odrig.build_flags}
  -D WLED_DISABLE_INFRARED
  -D WLED_USE_SHARED_RMT
  -D ESP32_ARDUINO_NO_RGB_BUILTIN
  -include @REPO@/firmware/newer/odrig_newer.h

[env:odrig_trial_probe]
extends = env:odrig_trial
build_flags = ${env:odrig_trial.build_flags}
  -D ODRIG_PROBE
